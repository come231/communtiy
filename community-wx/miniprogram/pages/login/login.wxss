.container {
  min-height: 100vh;
  background: linear-gradient(180deg, #667eea 0%, #764ba2 100%);
  padding: 100rpx 60rpx;
}

.logo-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 80rpx;
}

.logo {
  width: 160rpx;
  height: 160rpx;
  background-color: #fff;
  border-radius: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 30rpx;
}

.logo-text {
  font-size: 60rpx;
  font-weight: bold;
  color: #667eea;
}

.title {
  font-size: 40rpx;
  font-weight: bold;
  color: #fff;
  margin-bottom: 10rpx;
}

.subtitle {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.8);
}

.form-section {
  background-color: #fff;
  border-radius: 24rpx;
  padding: 40rpx;
  margin-bottom: 40rpx;
}

.form-item {
  margin-bottom: 30rpx;
}

.form-item:last-child {
  margin-bottom: 0;
}

.input {
  width: 100%;
  padding: 24rpx;
  border: 2rpx solid #E4E7ED;
  border-radius: 12rpx;
  font-size: 28rpx;
}

.input:focus {
  border-color: #667eea;
}

.login-btn {
  width: 100%;
  padding: 24rpx;
  background-color: #667eea;
  color: #fff;
  border-radius: 12rpx;
  font-size: 32rpx;
  font-weight: bold;
  border: none;
}

.login-btn.disabled {
  background-color: #CCCCCC;
}

.other-login {
  margin-bottom: 40rpx;
}

.other-login .divider {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 40rpx;
}

.other-login .line {
  flex: 1;
  height: 1rpx;
  background-color: rgba(255, 255, 255, 0.3);
}

.other-login .divider text {
  color: rgba(255, 255, 255, 0.8);
  font-size: 24rpx;
}

.oauth-list {
  display: flex;
  justify-content: center;
}

.oauth-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
  background: none;
  border: none;
  padding: 0;
}

.oauth-btn image {
  width: 80rpx;
  height: 80rpx;
}

.oauth-btn text {
  color: #fff;
  font-size: 24rpx;
}

.register-link {
  text-align: center;
  color: rgba(255, 255, 255, 0.8);
  font-size: 28rpx;
}

.register-link .link {
  color: #fff;
  margin-left: 10rpx;
}
