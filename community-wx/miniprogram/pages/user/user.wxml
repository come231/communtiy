<view class="container">
  <!-- 用户信息 -->
  <view class="user-card">
    <view class="user-bg"></view>
    <view class="user-content">
      <image class="avatar" src="{{userInfo.avatar || '/assets/default-avatar.png'}}" mode="aspectFill"></image>
      <text class="nickname">{{userInfo.nickname || userInfo.username}}</text>
      <text class="username">@{{userInfo.username}}</text>
      
      <view wx:if="{{userInfo.bio}}" class="bio">{{userInfo.bio}}</view>
      
      <view class="stats">
        <view class="stat-item">
          <text class="num">{{userInfo.followingCount || 0}}</text>
          <text class="label">关注</text>
        </view>
        <view class="stat-item">
          <text class="num">{{userInfo.followersCount || 0}}</text>
          <text class="label">粉丝</text>
        </view>
        <view class="stat-item">
          <text class="num">{{userInfo.postsCount || 0}}</text>
          <text class="label">帖子</text>
        </view>
      </view>

      <view class="actions">
        <button wx:if="{{!isMe}}" class="action-btn {{isFollowing ? 'following' : ''}}" bindtap="toggleFollow">
          {{isFollowing ? '已关注' : '+ 关注'}}
        </button>
        <button wx:if="{{!isMe}}" class="action-btn message-btn" bindtap="sendMessage">发消息</button>
      </view>
    </view>
  </view>

  <!-- 用户帖子 -->
  <view class="posts-section">
    <view class="section-header">
      <text class="title">Ta的帖子</text>
    </view>
    
    <view wx:if="{{posts.length === 0 && !loading}}" class="empty">
      <text>暂无帖子</text>
    </view>
    
    <view wx:if="{{loading}}" class="loading">
      <text>加载中...</text>
    </view>

    <view wx:for="{{posts}}" wx:key="postId" class="post-item" bindtap="goToPost" data-id="{{item.postId}}">
      <text class="title">{{item.title}}</text>
      <text class="summary">{{item.summary}}</text>
      <view class="meta">
        <text>{{item.createTimeStr}}</text>
        <text>浏览 {{item.viewCount || 0}}</text>
        <text>评论 {{item.commentCount || 0}}</text>
      </view>
    </view>

    <view wx:if="{{hasMore && !loading}}" class="load-more" bindtap="loadMore">
      <text>加载更多</text>
    </view>
  </view>
</view>
