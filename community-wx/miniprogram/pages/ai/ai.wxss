.container {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background-color: #F5F7FA;
}

.quick-actions {
  display: flex;
  gap: 20rpx;
  padding: 20rpx 30rpx;
  background-color: #fff;
  overflow-x: auto;
}

.quick-actions::-webkit-scrollbar {
  display: none;
}

.action-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  flex-shrink: 0;
  padding: 16rpx 24rpx;
  background-color: #F5F7FA;
  border-radius: 12rpx;
}

.action-item image {
  width: 48rpx;
  height: 48rpx;
}

.action-item text {
  font-size: 22rpx;
  color: #666;
}

.chat-area {
  flex: 1;
  padding: 20rpx 30rpx;
}

.welcome {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 0;
}

.welcome-icon {
  width: 120rpx;
  height: 120rpx;
  margin-bottom: 30rpx;
}

.welcome-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 16rpx;
}

.welcome-desc {
  font-size: 28rpx;
  color: #999;
  text-align: center;
}

.message-list {
  display: flex;
  flex-direction: column;
  gap: 30rpx;
}

.message-item {
  display: flex;
  gap: 16rpx;
  max-width: 85%;
}

.message-item.user {
  align-self: flex-end;
  flex-direction: row-reverse;
}

.message-item .avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.message-item .message-content {
  flex: 1;
}

.message-item .content-text {
  padding: 20rpx 24rpx;
  border-radius: 20rpx;
  font-size: 28rpx;
  line-height: 1.6;
}

.message-item.assistant .content-text {
  background-color: #fff;
  color: #333;
}

.message-item.user .content-text {
  background-color: #667eea;
  color: #fff;
}

.loading-msg {
  display: flex;
  justify-content: center;
  padding: 20rpx;
}

.loading-dots {
  display: flex;
  gap: 8rpx;
}

.loading-dots .dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background-color: #999;
  animation: bounce 1.4s infinite ease-in-out both;
}

.loading-dots .dot:nth-child(1) { animation-delay: -0.32s; }
.loading-dots .dot:nth-child(2) { animation-delay: -0.16s; }

@keyframes bounce {
  0%, 80%, 100% { transform: scale(0); }
  40% { transform: scale(1); }
}

.input-area {
  display: flex;
  align-items: center;
  padding: 20rpx 30rpx;
  background-color: #fff;
  border-top: 1rpx solid #F0F0F0;
}

.input-area .input {
  flex: 1;
  padding: 20rpx 30rpx;
  background-color: #F5F7FA;
  border-radius: 40rpx;
  font-size: 28rpx;
}

.input-area .send-btn {
  margin-left: 20rpx;
  padding: 16rpx 36rpx;
  background-color: #667eea;
  color: #fff;
  border-radius: 32rpx;
  font-size: 28rpx;
}

.input-area .send-btn.active {
  background-color: #667eea;
}

.input-area .send-btn[disabled] {
  background-color: #CCCCCC;
}
