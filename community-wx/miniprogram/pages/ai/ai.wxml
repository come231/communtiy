<view class="container">
  <!-- 快捷功能 -->
  <view class="quick-actions">
    <view wx:for="{{quickActions}}" wx:key="type" class="action-item" bindtap="onQuickAction" data-type="{{item.type}}">
      <image src="{{item.icon}}" mode="aspectFit"></image>
      <text>{{item.label}}</text>
    </view>
  </view>

  <!-- 聊天区域 -->
  <scroll-view scroll-y class="chat-area" scroll-top="{{scrollTop}}" scroll-with-animation>
    <view wx:if="{{messages.length === 0}}" class="welcome">
      <image class="welcome-icon" src="/assets/icons/ai.png" mode="aspectFit"></image>
      <text class="welcome-title">AI助手</text>
      <text class="welcome-desc">你好！我是AI助手，有什么可以帮助你的吗？</text>
    </view>
    <view wx:else class="message-list">
      <view wx:for="{{messages}}" wx:key="id" class="message-item {{item.role === 'user' ? 'user' : 'assistant'}}">
        <image wx:if="{{item.role === 'assistant'}}" class="avatar" src="/assets/icons/ai.png" mode="aspectFit"></image>
        <view class="message-content">
          <view class="content-text">{{item.content}}</view>
        </view>
        <image wx:if="{{item.role === 'user'}}" class="avatar" src="{{userAvatar || '/assets/default-avatar.png'}}" mode="aspectFit"></image>
      </view>
      <view wx:if="{{loading}}" class="loading-msg">
        <view class="loading-dots">
          <view class="dot"></view>
          <view class="dot"></view>
          <view class="dot"></view>
        </view>
      </view>
    </view>
  </scroll-view>

  <!-- 输入区域 -->
  <view class="input-area">
    <input 
      class="input" 
      placeholder="输入你的问题..." 
      value="{{inputText}}"
      bindinput="onInput"
      bindconfirm="onSend"
      confirm-type="send"
    />
    <button class="send-btn {{inputText.trim() ? 'active' : ''}}" bindtap="onSend" disabled="{{!inputText.trim() || loading}}">
      发送
    </button>
  </view>
</view>
