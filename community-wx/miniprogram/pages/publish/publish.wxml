<view class="container">
  <!-- 导航栏 -->
  <view class="nav-bar">
    <text class="cancel-btn" bindtap="onCancel">取消</text>
    <text class="title">发布帖子</text>
    <text class="publish-btn {{canPublish ? '' : 'disabled'}}" bindtap="onPublish">发布</text>
  </view>

  <!-- 表单 -->
  <view class="form">
    <!-- 标题 -->
    <view class="form-item">
      <input 
        class="title-input" 
        placeholder="标题（必填，5-100字）" 
        value="{{form.title}}"
        maxlength="100"
        bindinput="onTitleInput"
      />
    </view>

    <!-- 内容 -->
    <view class="form-item content-item">
      <textarea 
        class="content-input" 
        placeholder="分享你的想法..." 
        value="{{form.content}}"
        maxlength="10000"
        bindinput="onContentInput"
        auto-height
      />
    </view>

    <!-- 图片上传 -->
    <view class="form-item">
      <view class="upload-section">
        <view class="upload-list">
          <view wx:for="{{images}}" wx:key="index" class="upload-item">
            <image src="{{item}}" mode="aspectFill"></image>
            <view class="delete-btn" bindtap="deleteImage" data-index="{{index}}">×</view>
          </view>
          <view wx:if="{{images.length < 9}}" class="upload-btn" bindtap="chooseImage">
            <text class="icon">+</text>
            <text class="text">图片</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 板块选择 -->
    <view class="form-item">
      <view class="section-picker" bindtap="showSectionPicker">
        <text class="label">板块</text>
        <text class="value {{form.sectionName ? '' : 'placeholder'}}">{{form.sectionName || '选择板块（可选）'}}</text>
        <text class="arrow">></text>
      </view>
    </view>

    <!-- 话题选择 -->
    <view class="form-item">
      <view class="label">话题</view>
      <view class="topic-list">
        <view 
          wx:for="{{topics}}" 
          wx:key="topicId"
          class="topic-item {{form.topicIds.includes(item.topicId) ? 'active' : ''}}"
          bindtap="toggleTopic"
          data-id="{{item.topicId}}"
        >
          #{{item.name}}
        </view>
      </view>
    </view>

    <!-- 匿名发布 -->
    <view class="form-item">
      <view class="anonymous-section">
        <text class="label">匿名发布</text>
        <switch checked="{{form.isAnonymous}}" bindchange="onAnonymousChange" color="#409EFF"/>
      </view>
    </view>
  </view>

  <!-- 字数统计 -->
  <view class="word-count">
    <text>{{form.content.length || 0}}</text>
    <text>/10000</text>
  </view>
</view>
