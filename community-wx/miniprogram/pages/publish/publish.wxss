.container {
  min-height: 100vh;
  background-color: #F5F7FA;
}

.nav-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 30rpx;
  background-color: #fff;
  border-bottom: 1rpx solid #F0F0F0;
}

.cancel-btn {
  font-size: 28rpx;
  color: #666;
}

.title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.publish-btn {
  font-size: 28rpx;
  color: #409EFF;
  font-weight: 500;
}

.publish-btn.disabled {
  color: #CCCCCC;
}

.form {
  background-color: #fff;
  margin-top: 20rpx;
}

.form-item {
  padding: 30rpx;
  border-bottom: 1rpx solid #F5F5F5;
}

.title-input {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  width: 100%;
}

.content-item {
  min-height: 400rpx;
}

.content-input {
  font-size: 30rpx;
  color: #333;
  line-height: 1.8;
  width: 100%;
  min-height: 300rpx;
}

.upload-section {
  width: 100%;
}

.upload-list {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.upload-item {
  position: relative;
  width: 200rpx;
  height: 200rpx;
  border-radius: 12rpx;
  overflow: hidden;
}

.upload-item image {
  width: 100%;
  height: 100%;
}

.delete-btn {
  position: absolute;
  top: 0;
  right: 0;
  width: 40rpx;
  height: 40rpx;
  background-color: rgba(0, 0, 0, 0.5);
  color: #fff;
  font-size: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.upload-btn {
  width: 200rpx;
  height: 200rpx;
  border: 2rpx dashed #DDDDDD;
  border-radius: 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
}

.upload-btn .icon {
  font-size: 60rpx;
  color: #CCCCCC;
}

.upload-btn .text {
  font-size: 24rpx;
  color: #999;
}

.section-picker {
  display: flex;
  align-items: center;
}

.section-picker .label {
  font-size: 28rpx;
  color: #333;
  margin-right: 20rpx;
}

.section-picker .value {
  flex: 1;
  font-size: 28rpx;
  color: #333;
}

.section-picker .value.placeholder {
  color: #999;
}

.section-picker .arrow {
  color: #CCCCCC;
  font-size: 28rpx;
}

.topic-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 20rpx;
}

.topic-item {
  padding: 12rpx 24rpx;
  border-radius: 28rpx;
  background-color: #F5F5F5;
  color: #666;
  font-size: 26rpx;
}

.topic-item.active {
  background-color: #409EFF;
  color: #fff;
}

.anonymous-section {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.anonymous-section .label {
  font-size: 28rpx;
  color: #333;
}

.word-count {
  position: fixed;
  bottom: 40rpx;
  right: 30rpx;
  font-size: 24rpx;
  color: #999;
}
